# Environment variables — set these in Vercel (never commit real values)

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Flutterwave payments (optional — enables online deposit)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Resend email (optional — enables booking emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
